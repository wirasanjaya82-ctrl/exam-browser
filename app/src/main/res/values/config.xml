<?xml version="1.0" encoding="utf-8"?>
<!--
    ===== PENGATURAN APLIKASI (boleh diubah) =====
    Ubah teks di antara tanda > dan < saja, lalu simpan (Commit).
    GitHub akan otomatis merakit ulang APK-nya.
    true = ya / aktif, false = tidak / nonaktif
-->
<resources>
    <!-- ===== Umum ===== -->
    <!-- Nama aplikasi yang muncul di HP -->
    <string name="app_name">Exambro SMAN4</string>

    <!-- Nama sekolah, tampil di layar depan dan di atas layar ujian -->
    <string name="school_name">SMA Negeri 4 Medan</string>

    <!-- Password pengawas untuk keluar dari ujian.
         Kosongkan (<string name="exit_password"></string>) jika tanpa password. -->
    <string name="exit_password">123456</string>

    <!-- ===== Link ujian ===== -->
    <!-- Batasi link yang boleh dibuka. Contoh: https://script.google.com/
         Kosongkan jika semua link boleh dibuka. -->
    <string name="allowed_link_prefix"></string>

    <!-- true = siswa boleh ketik / tempel / bagikan link, false = hanya lewat scan barcode -->
    <bool name="allow_manual_link">true</bool>

    <!-- ===== Cek Perangkat ===== -->
    <!-- true = tampilkan dan jalankan Cek Perangkat sebelum ujian -->
    <bool name="cek_perangkat">true</bool>

    <!-- Untuk setiap pengecekan:
         true  = WAJIB (ujian tidak bisa dimulai jika belum sesuai)
         false = hanya PERINGATAN (siswa tetap boleh lanjut) -->
    <bool name="wajib_internet">true</bool>
    <bool name="wajib_opsi_pengembang_mati">true</bool>
    <bool name="wajib_aksesibilitas_mati">true</bool>
    <bool name="wajib_tidak_root">true</bool>
    <bool name="wajib_baterai">false</bool>
    <bool name="wajib_jangan_ganggu">true</bool>
    <bool name="wajib_memori">false</bool>
    <bool name="wajib_kamera">false</bool>

    <!-- Batas minimal baterai (persen) sebelum ujian dimulai -->
    <integer name="minimal_baterai">20</integer>

    <!-- Selama ujian: muncul peringatan jika baterai di bawah angka ini (persen) -->
    <integer name="peringatan_baterai_ujian">15</integer>
</resources>
